# ─── Frontend (Next.js) environment ───────────────────────────
# Copy this file to `.env.local` and fill in. NEVER commit `.env.local`.
# Only NEXT_PUBLIC_* variables are exposed to the browser — never put
# secrets here.

# Base URL of the NestJS API (note the /api prefix).
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Storefront display name.
NEXT_PUBLIC_APP_NAME="Nandana Textile"

# The shop's public address: canonical URLs, sitemap, robots.txt and structured
# data. Use the live host (www); the bare domain redirects to it.
NEXT_PUBLIC_SITE_URL=https://www.nandanatextile.lk

# Server-side address of the API for the /uploads proxy (optional; defaults to
# NEXT_PUBLIC_API_URL without /api/v1).
# INTERNAL_BACKEND_URL=http://localhost:3001
