# ─── Backend API (NestJS) environment ────────────────────────────────────────
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Keep this template in sync whenever the code reads a new variable.
# Production values (Render): see docs/RUNBOOK.md, section 2.

# ─── Runtime ──────────────────────────────────────────────────────────────────
# "production" turns on secure cookies, strict CORS, real OTP checks and the
# boot-time secret checks. Unset locally (defaults to development).
# NODE_ENV="production"
PORT=3001

# ─── Database (PostgreSQL 16) ─────────────────────────────────────────────────
# Defaults: the local Docker database from docker-compose.yml (host port 5433,
# reachable from this computer only). Development only; production uses Neon
# with its own credentials (docs/RUNBOOK.md, section 2).
DATABASE_URL="postgresql://textile_admin:textile_secure_pass_2024@127.0.0.1:5433/textile_db?schema=public"
# Neon: the DIRECT (non-pooled) URL, so `prisma migrate` can run DDL.
# Local Docker: the same value as DATABASE_URL.
DIRECT_URL="postgresql://textile_admin:textile_secure_pass_2024@127.0.0.1:5433/textile_db?schema=public"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# At least 32 characters, checked at boot. Generate: openssl rand -hex 32
JWT_SECRET="change-me-in-production-min-32-characters-long"
JWT_EXPIRATION="7d"   # refresh-session lifetime; access tokens last 15 minutes

# ─── Web origins ──────────────────────────────────────────────────────────────
# The storefront's address: CORS origin, and the base of links in emails.
FRONTEND_URL="http://localhost:3000"
# Extra allowed browser origins, comma-separated (e.g. the www and bare domain).
# CORS_ALLOWED_ORIGINS="https://www.example.lk,https://example.lk"
# Public origin of this API, used to build disk-stored upload URLs. On Render,
# RENDER_EXTERNAL_URL is used when this is unset.
# PUBLIC_API_URL="https://your-api.onrender.com"
# Swagger UI at /api/v1/docs: off when NODE_ENV=production unless forced.
# SWAGGER_ENABLED="false"

# ─── Image uploads (Cloudinary) ───────────────────────────────────────────────
# REQUIRED IN PRODUCTION on hosts with a temporary disk (Render free tier wipes
# it on every deploy and wake-up). With all three set, product and review photos
# are stored in Cloudinary; without them they go to ./uploads (local dev only).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Review photos: daily quota per customer, per-minute limit, orphan clean-up.
# REVIEW_UPLOADS_PER_DAY=20
# REVIEW_UPLOAD_THROTTLE_LIMIT=10
# ORPHAN_UPLOAD_TTL_HOURS=24

# ─── AI service link ──────────────────────────────────────────────────────────
# Where the FastAPI service is, and the shared key both services must use.
# The AI service refuses the default key in production. Generate: openssl rand -hex 32
AI_SERVICE_URL="http://localhost:8000"
INTERNAL_API_KEY="local-dev-internal-key"
# How long to wait for the AI service. 30000+ absorbs a free-tier cold start.
AI_TIMEOUT_MS=30000

# ─── Payments ─────────────────────────────────────────────────────────────────
# PayHere (LKR). The secret is used server-side only, to sign and verify hashes.
PAYHERE_MERCHANT_ID="1221149"
PAYHERE_MERCHANT_SECRET="your-payhere-sandbox-secret"
PAYHERE_MODE="sandbox"   # "sandbox" | "live" — never sandbox on a shop taking real orders
# Must be publicly reachable for PayHere's server-to-server notification.
PAYHERE_NOTIFY_URL="http://localhost:3001/api/v1/payments/payhere/notify"
# Legacy Stripe path, kept in no-network mock mode.
STRIPE_SECRET_KEY="sk_test_mock"
STRIPE_PUBLISHABLE_KEY="pk_test_mock"
STRIPE_WEBHOOK_SECRET="whsec_mock"

# ─── Email (Resend) and SMS — optional locally ────────────────────────────────
# Without a key, emails are logged instead of sent. In production the sender
# MUST use a domain verified in Resend: the shared onboarding@resend.dev
# address only delivers to the Resend account owner's own inbox.
RESEND_API_KEY=""
EMAIL_FROM="Nandana Textile <no-reply@your-verified-domain.lk>"
# New-order and payment-mismatch alerts. Skipped when unset.
ADMIN_ALERT_EMAIL=""
ADMIN_ALERT_PHONE=""   # e.g. "+94771234567" (needs an SMS provider)
# SMS gateway (Sri Lanka): "notifylk" (also needs SMS_USER_ID) or "textlk".
# Without it, phone-number verification codes and SMS resets cannot be delivered.
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_SENDER_ID=""   # the sender ID your SMS provider approved
SMS_USER_ID=""     # Notify.lk only

# ─── Social sharing (optional) ────────────────────────────────────────────────
# Without META_PAGE_TOKEN captions are still generated for copy / WhatsApp;
# adding a token turns on Facebook / Instagram posting.
META_PAGE_ID=""
META_PAGE_TOKEN=""
META_IG_USER_ID=""
META_GRAPH_VERSION="v21.0"
# Caption and invoice details (not secret). Only list payment options the shop
# really offers: captions repeat SHOP_PAYMENTS word for word.
SHOP_BRAND="Nandana Textile"
SHOP_BASE_URL="https://www.nandanatextile.lk"
SHOP_WHATSAPP="+9477XXXXXXX"
SHOP_PAYMENTS=""
SHOP_ADDRESS="50 Main St, Veyangoda"
SHOP_LANDLINE="033 228 8445"
SHOP_REG_NO=""   # e.g. "BR: PV 12345" — printed on invoices
SHOP_BANK=""     # e.g. "BOC 1234567 · Veyangoda" — printed on invoices

# ─── Rate limiting and proxies (advanced) ─────────────────────────────────────
# Requests per minute per client IP (default 100). Auth endpoints are stricter.
# THROTTLE_LIMIT=100
# Proxies in front of the API (Render sets RENDER and gets 1 automatically).
# TRUST_PROXY_HOPS=1

# ─── Redis — not used by the API ──────────────────────────────────────────────
# docker-compose still starts a Redis container; nothing reads these today.
REDIS_HOST="localhost"
REDIS_PORT=6379

# ─── LLM (read by the AI service) ─────────────────────────────────────────────
# docker-compose passes this file to the AI service too. Free key (no card):
# https://console.groq.com/keys
LLM_PROVIDER="groq"
LLM_API_KEY=""
LLM_MODEL="openai/gpt-oss-120b"
LLM_BASE_URL="https://api.groq.com/openai/v1/chat/completions"
