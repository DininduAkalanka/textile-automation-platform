# ─── AI Microservice Configuration (FastAPI) ──────────────────────────────
# Read-only database connection for safe catalog retrieval
DATABASE_URL_READONLY="postgresql://textile_ai_readonly:ai_readonly_local_dev_password@localhost:5433/textile_db"
INTERNAL_API_KEY="local-dev-internal-key"

# ─── Free Groq LLM Configuration (No credit card needed) ───────────────────
# 1. Sign up at https://console.groq.com/keys
# 2. Generate a free API key (starts with gsk_...)
LLM_PROVIDER="groq"
LLM_API_KEY=""                # Paste your gsk_... key here
LLM_MODEL="llama-3.3-70b-versatile"
LLM_BASE_URL="https://api.groq.com/openai/v1/chat/completions"

# Assistant settings
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=700
RETRIEVAL_K=8
MAX_MESSAGE_CHARS=500
MAX_HISTORY_TURNS=6
