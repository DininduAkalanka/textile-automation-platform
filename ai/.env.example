# ─── AI Microservice Configuration (FastAPI) ──────────────────────────────
# Copy to `.env`. NEVER commit `.env`. Production values: docs/RUNBOOK.md.
#
# In production (RENDER set, NODE_ENV=production or ENVIRONMENT=production) the
# service refuses to start with the default INTERNAL_API_KEY or the default
# read-only password below: rotate both (docs/RUNBOOK.md, section 3.1).

# Read-only database role (created by the migrations): SELECT on the catalogue
# and the PII-free analytics views only.
DATABASE_URL_READONLY="postgresql://textile_ai_readonly:ai_readonly_local_dev_password@localhost:5433/textile_db"
INTERNAL_API_KEY="local-dev-internal-key"

# ─── Free Groq LLM Configuration (No credit card needed) ───────────────────
# 1. Sign up at https://console.groq.com/keys
# 2. Generate a free API key (starts with gsk_...)
LLM_PROVIDER="groq"
LLM_API_KEY=""                # Paste your gsk_... key here
LLM_MODEL="openai/gpt-oss-120b"
LLM_BASE_URL="https://api.groq.com/openai/v1/chat/completions"

# Assistant settings
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=700
RETRIEVAL_K=8
MAX_MESSAGE_CHARS=500
MAX_HISTORY_TURNS=6

# Interactive API docs (/docs): off in production unless set to true.
# AI_DOCS_ENABLED=false
